# Backend env template — copy to .env and fill values
# No matching Atlas project exists for LMS yet. Pick any cluster and add /lms as DB name,
# or create a fresh project. Mongoose will create collections on first save.

PORT=
MONGO_URI=
CLIENT_URL=

# JWT
JWT_SECRET=
JWT_EXPIRY=

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (subscription payments)
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
RAZORPAY_PLAN_ID=

# SMTP (transactional email)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Contact-us inbox
CONTACT_US_EMAIL=
